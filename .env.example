# Copy this file to .env.local and fill in the values. Never commit .env.local.

# Supabase: Project Settings > API Keys. The publishable key is safe to show in the
# browser (row-level security protects the data). An older "anon" key also works.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Server-only, added later for moderation jobs. Keep it secret; never prefix it NEXT_PUBLIC_.
SUPABASE_SECRET_KEY=

# Claude API, added later for drafting cards and pre-checking submissions.
ANTHROPIC_API_KEY=
